#! /usr/bin/env ruby

# frozen_string_literal: true

=begin

  f_dot

  entry point for f_dot.

  by i2097i

=end

require :f_dot.to_s

begin
  if ARGV[0]&.strip&.to_sym == :cubicus
    # start in FDot::DISPLAY_MODES[:websockets] display_mode
    # start websocket thread
    FDot::Based::Cubicus.instance.start_ws_thread
  end

  # run based f_dot
  FDot::Based::Processor.instance.run
rescue StandardError => e
  puts "rescued in f_dot bin for #{e}"
  puts Thread.current.backtrace
  raise e
end